---
import SiteLayout from "../layouts/SiteLayout.astro";
import FeatureExplorer from "../components/FeatureExplorer.astro";
import FeatureModal from "../components/FeatureModal.astro";
---

<SiteLayout
	title="Features"
	description="Explore all features of Taj's Mod for Upload Labs. Search and filter through QoL, visuals, tools, and gameplay enhancements."
>
	<section
		class="py-16 md:py-20 relative overflow-hidden border-b border-glass-border"
	>
		<div class="container-wide text-center relative z-10">
			<h1 class="text-4xl md:text-5xl font-bold mb-4 text-on-background">
				All Features
			</h1>
			<p class="text-on-surface-variant max-w-2xl mx-auto text-lg">
				Discover everything Taj's Mods ecosystem has to offer.
			</p>
		</div>
		<div
			class="absolute -top-24 -right-24 w-96 h-96 bg-surface-tint/5 rounded-full blur-[100px]"
		>
		</div>
	</section>

	<!-- Feature Explorer -->
	<FeatureExplorer />

	<!-- Feature Detail Modal -->
	<FeatureModal />
</SiteLayout>
