---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../utils/urls";
---

<SiteLayout title="Page Not Found">
	<section class="min-h-[70vh] flex items-center justify-center">
		<div class="container-narrow text-center py-20">
			<div class="text-8xl mb-6">🔍</div>
			<h1
				class="text-4xl md:text-5xl font-bold mb-4 font-mono uppercase tracking-tighter"
			>
				Error <span class="text-surface-tint">404</span>
			</h1>
			<p class="text-gray-400 text-lg mb-8 max-w-md mx-auto">
				The requested module could not be found or has been decommissioned.
			</p>

			<!-- Quick Actions -->
			<div
				class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12"
			>
				<a href={sitePath("/")} class="btn-primary"> Return to Hub </a>
				<a href={sitePath("/mods/")} class="btn-secondary"> Browse Modules </a>
			</div>

			<!-- Popular Pages -->
			<div class="mt-8 pt-8 border-t border-white/10">
				<p
					class="text-xs font-mono text-gray-500 uppercase tracking-widest mb-6"
				>
					Access Points:
				</p>
				<div class="flex flex-wrap justify-center gap-3">
					<a href={sitePath("/mods/")} class="chip">Modules</a>
					<a href={sitePath("/docs/")} class="chip">Documentation</a>
					<a href={sitePath("/faq/")} class="chip">FAQ</a>
					<a href={sitePath("/troubleshooting/")} class="chip"
						>Troubleshooting</a
					>
				</div>
			</div>
		</div>
	</section>
</SiteLayout>
