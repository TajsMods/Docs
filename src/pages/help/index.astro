---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { siteConfig } from "../../config/site";
import { sitePath } from "../../utils/urls";

// Documentation sections linking to Starlight docs at /docs/
const docSections = [
  {
    title: "Core API",
    description: "Core API documentation for developers",
    href: sitePath('/docs/core/api/'),
    icon: "📖",
  },
  {
    title: "Keybinds API",
    description: "Keybinds Manager API reference",
    href: sitePath('/docs/core/keybinds_api/'),
    icon: "⌨️",
  },
  {
    title: "Module Guide",
    description: "Guide for creating new modules",
    href: sitePath('/docs/core/module_guide/'),
    icon: "🏗️",
  },
  {
    title: "Settings & Migrations",
    description: "Settings and migrations guide",
    href: sitePath('/docs/core/settings_and_migrations/'),
    icon: "⚙️",
  },
];
---

<SiteLayout
  title="Help Center"
  description="Help center for Taj's Mod. Quick start guides and documentation links."
>
  <section class="py-16 md:py-20 relative overflow-hidden border-b border-white/5">
    <div class="container-wide text-center relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">Help Center</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-lg">
        Everything you need to know about using and contributing to Taj's Mods.
      </p>
    </div>
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-surface-tint/5 rounded-full blur-[100px]"></div>
  </section>

  <!-- Quick Start -->
  <section class="section relative z-10">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto mb-16">
        <div class="glass-card rounded-2xl p-8">
          <div class="flex items-start gap-4">
            <div class="text-4xl">🚀</div>
            <div>
              <h2 class="text-xl font-semibold mb-2 text-white">Quick Start</h2>
              <p class="text-gray-400 mb-4">
                Getting started with Taj's Mods is quick and easy.
              </p>
              <ol class="list-decimal list-inside space-y-2 text-gray-300 mb-4">
                <li>
                  <strong>Subscribe</strong> on the <a
                    href={siteConfig.steamWorkshop}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-surface-tint hover:underline"
                    >Steam Workshop</a
                  >
                </li>
                <li>
                  <strong>Launch</strong> Upload Labs — the modules load automatically
                </li>
                <li>
                  <strong>Configure</strong> in-game via the modular settings panel
                </li>
                <li>
                  <strong>Search</strong> using the Command Palette (if installed)
                </li>
              </ol>
              <a
                href={sitePath('/faq/')}
                class="btn-secondary text-sm"
              >
                Having issues? Check the FAQ
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Documentation Sections -->
      <h2 class="text-2xl font-bold mb-8 text-center text-white">
        Documentation
      </h2>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto"
      >
        {
          docSections.map((doc) => (
            <a href={doc.href} class="glass-card p-6 rounded-xl border border-white/5 hover:border-surface-tint/30 transition-colors group block">
              <div class="flex items-center gap-4 mb-3">
                <span class="text-3xl">{doc.icon}</span>
                <h3 class="text-xl font-semibold text-white group-hover:text-surface-tint transition-colors">{doc.title}</h3>
              </div>
              <p class="text-gray-400 text-sm">{doc.description}</p>
            </a>
          ))
        }
      </div>

      <!-- Full Docs Link -->
      <div class="text-center mt-12">
        <p class="text-gray-400 mb-4">
          Looking for more detailed technical documentation?
        </p>
        <a
          href={sitePath('/docs/')}
          class="btn-primary"
        >
          <span>📚</span>
          Browse Full Documentation
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
