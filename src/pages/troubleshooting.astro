---
import SiteLayout from "../layouts/SiteLayout.astro";
import { siteConfig } from "../config/site";
import CopyButton from "../components/CopyButton.astro";
import PageActions from "../components/PageActions.astro";

// Configurable troubleshooting paths
const troubleshootingConfig = {
  paths: {
    windows: {
      game: "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Upload Labs",
      mods: "C:\\Program Files (x86)\\Steam\\steamapps\\workshop\\content\\3606890",
      config: "%APPDATA%\\Upload Labs\\tajs_mod_config.json",
      logs: "%APPDATA%\\Upload Labs\\logs",
      saves: "%APPDATA%\\Upload Labs\\",
    },
    linux: {
      game: "~/.steam/steam/steamapps/common/Upload Labs",
      mods: "~/.steam/steam/steamapps/workshop/content/3606890",
      config: "~/.config/app_userdata/Upload Labs/tajs_mod_config.json",
      logs: "~/.local/share/app_userdata/Upload Labs/logs",
    },
    mac: {
      game: "Unsupported",
      mods: "Unsupported",
      config: "Unsupported",
    },
  },
};
---

<SiteLayout
  title="Troubleshooting"
  description="Diagnostic checklist and common fixes for Taj's Mods issues."
>
  <section class="py-16 md:py-20 relative overflow-hidden border-b border-outline-variant">
    <div class="container-wide text-center relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-on-background">Troubleshooting</h1>
      <p class="text-on-surface-variant max-w-2xl mx-auto text-lg">
        Diagnostic checklist and quick fixes for common issues
      </p>
    </div>
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-surface-tint/5 rounded-full blur-[100px]"></div>
  </section>

  <section class="section relative z-10">
    <div class="container-narrow">
      <!-- Quick Diagnosis (Interactive) -->
      <div
        class="glass-card mb-12 p-8 rounded-2xl bg-surface-tint/5 border-surface-tint/20"
        id="diagnosis-card"
      >
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2 text-surface-tint uppercase tracking-wider font-mono">
          <span>⚡</span>
          Diagnostic Checklist
        </h2>
        <div class="space-y-4" id="checklist">
          <label
            class="flex items-start gap-3 cursor-pointer group"
            data-check="subscribed"
          >
            <input
              type="checkbox"
              class="diagnosis-check mt-1 h-4 w-4 rounded border-outline-variant bg-surface-container text-surface-tint focus:ring-surface-tint"
            />
            <span class="text-on-surface-variant group-hover:text-on-surface transition-colors">Is the mod subscribed on Steam Workshop?</span>
          </label>
          <label
            class="flex items-start gap-3 cursor-pointer group"
            data-check="launched"
          >
            <input
              type="checkbox"
              class="diagnosis-check mt-1 h-4 w-4 rounded border-outline-variant bg-surface-container text-surface-tint focus:ring-surface-tint"
            />
            <span class="text-on-surface-variant group-hover:text-on-surface transition-colors">Have you launched the game after subscribing?</span>
          </label>
          <label
            class="flex items-start gap-3 cursor-pointer group"
            data-check="sync"
          >
            <input
              type="checkbox"
              class="diagnosis-check mt-1 h-4 w-4 rounded border-outline-variant bg-surface-container text-surface-tint focus:ring-surface-tint"
            />
            <span class="text-on-surface-variant group-hover:text-on-surface transition-colors">Is Steam Workshop sync enabled?</span>
          </label>
          <label
            class="flex items-start gap-3 cursor-pointer group"
            data-check="conflict"
          >
            <input
              type="checkbox"
              class="diagnosis-check mt-1 h-4 w-4 rounded border-outline-variant bg-surface-container text-surface-tint focus:ring-surface-tint"
            />
            <span class="text-on-surface-variant group-hover:text-on-surface transition-colors">Are other mods disabled (to test conflict)??</span>
          </label>
          <label
            class="flex items-start gap-3 cursor-pointer group"
            data-check="resub"
          >
            <input
              type="checkbox"
              class="diagnosis-check mt-1 h-4 w-4 rounded border-outline-variant bg-surface-container text-surface-tint focus:ring-surface-tint"
            />
            <span class="text-on-surface-variant group-hover:text-on-surface transition-colors">Have you tried unsubscribing and resubscribing?</span>
          </label>
        </div>

        <!-- Dynamic Guidance -->
        <div id="diagnosis-result" class="mt-8 hidden space-y-4">
          <div
            id="guidance-subscribed"
            class="hidden p-5 rounded-xl bg-red-500/10 border border-red-500/30"
          >
            <h4 class="font-bold text-red-600 dark:text-red-400 mb-2 uppercase text-xs tracking-widest font-mono">
              CRITICAL: Subscription Required
            </h4>
            <p class="text-on-surface-variant text-sm">
              Visit the <a
                href={siteConfig.steamWorkshop}
                target="_blank"
                class="text-surface-tint hover:underline">Steam Workshop page</a
              > and click "Subscribe".
            </p>
          </div>

          <div
            id="guidance-launched"
            class="hidden p-5 rounded-xl bg-yellow-500/10 border border-yellow-500/30"
          >
            <h4 class="font-bold text-yellow-700 dark:text-yellow-400 mb-2 uppercase text-xs tracking-widest font-mono">
              WARNING: Boot Required
            </h4>
            <p class="text-on-surface-variant text-sm">
              Close Upload Labs completely and launch it again. Steam needs to
              download and initialize the Workshop content.
            </p>
          </div>

          <div
            id="guidance-sync"
            class="hidden p-5 rounded-xl bg-yellow-500/10 border border-yellow-500/30"
          >
            <h4 class="font-bold text-yellow-700 dark:text-yellow-400 mb-2 uppercase text-xs tracking-widest font-mono">
              WARNING: Sync Check
            </h4>
            <p class="text-on-surface-variant text-sm">
              In Steam: Right-click Upload Labs → Properties → Updates → Ensure
              "Always keep this game updated" is selected.
            </p>
          </div>

          <div
            id="guidance-conflict"
            class="hidden p-5 rounded-xl bg-blue-500/10 border border-blue-500/30"
          >
            <h4 class="font-bold text-blue-600 dark:text-blue-400 mb-2 uppercase text-xs tracking-widest font-mono">
              INFO: Conflict Isolation
            </h4>
            <p class="text-on-surface-variant text-sm">
              Disable all other mods and see if Taj's Mods work alone. If they
              do, re-enable mods one by one to find the conflict.
            </p>
          </div>

          <div
            id="guidance-resub"
            class="hidden p-5 rounded-xl bg-blue-500/10 border border-blue-500/30"
          >
            <h4 class="font-bold text-blue-600 dark:text-blue-400 mb-2 uppercase text-xs tracking-widest font-mono">
              INFO: Force Refresh
            </h4>
            <p class="text-on-surface-variant text-sm">
              Unsubscribe from the mod, restart Steam, then subscribe again.
              This forces a fresh download.
            </p>
          </div>

          <div
            id="guidance-all-checked"
            class="hidden p-5 rounded-xl bg-green-500/10 border border-green-500/30"
          >
            <h4 class="font-bold text-green-600 dark:text-green-400 mb-2 uppercase text-xs tracking-widest font-mono">
              SUCCESS: Basic Checks Complete
            </h4>
            <p class="text-on-surface-variant text-sm">
              If the issue persists, please report it on <a
                href="https://github.com/TajsMods/Core/issues/new"
                target="_blank"
                class="text-surface-tint hover:underline">GitHub</a
              > or <a
                href="https://discord.gg/enigmadev"
                target="_blank"
                class="text-surface-tint hover:underline">Discord</a
              > with your log files.
            </p>
          </div>
        </div>
      </div>

      <script>
        function initDiagnosis() {
          const checks = document.querySelectorAll(".diagnosis-check");
          const resultDiv = document.getElementById("diagnosis-result");

          function updateGuidance() {
            const states = {
              subscribed: !(document.querySelector(
                '[data-check="subscribed"] input'
              ) as HTMLInputElement)?.checked,
              launched: !(document.querySelector('[data-check="launched"] input') as HTMLInputElement)?.checked,
              sync: !(document.querySelector('[data-check="sync"] input') as HTMLInputElement)?.checked,
              conflict: !(document.querySelector('[data-check="conflict"] input') as HTMLInputElement)?.checked,
              resub: !(document.querySelector('[data-check="resub"] input') as HTMLInputElement)?.checked,
            };

            const allChecked = Object.values(states).every((v) => !v);
            const anyUnchecked = Object.values(states).some((v) => v);

            // Show result section if any state applies
            resultDiv?.classList.toggle("hidden", !anyUnchecked && !allChecked);

            // Toggle individual guidance boxes
            document
              .getElementById("guidance-subscribed")
              ?.classList.toggle("hidden", !states.subscribed);
            document
              .getElementById("guidance-launched")
              ?.classList.toggle(
                "hidden",
                states.subscribed || !states.launched
              );
            document
              .getElementById("guidance-sync")
              ?.classList.toggle(
                "hidden",
                states.subscribed || states.launched || !states.sync
              );
            document
              .getElementById("guidance-conflict")
              ?.classList.toggle("hidden", !states.conflict);
            document
              .getElementById("guidance-resub")
              ?.classList.toggle("hidden", !states.resub);
            document
              .getElementById("guidance-all-checked")
              ?.classList.toggle("hidden", !allChecked);
          }

          checks.forEach((check) =>
            check.addEventListener("change", updateGuidance)
          );
          updateGuidance();
        }

        document.addEventListener("astro:page-load", initDiagnosis);
        initDiagnosis();
      </script>

      <!-- Important Paths -->
      <div class="glass-card mb-8 p-8 rounded-2xl">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2 text-on-background font-mono uppercase tracking-widest">
          <span>📂</span>
          Storage Nodes (Windows)
        </h2>
        <div class="space-y-4">
          {
            Object.entries(troubleshootingConfig.paths.windows).map(
              ([key, path]) => (
                <div class="flex flex-col lg:flex-row lg:items-center gap-2 group">
                  <span class="font-mono text-xs uppercase text-on-surface-variant min-w-[100px] tracking-tighter group-hover:text-surface-tint transition-colors">
                    {key}:
                  </span>
                  <div class="flex-1 flex items-center gap-2 min-w-0">
                    <code class="flex-1 text-xs bg-surface-container border border-outline-variant px-3 py-1.5 rounded-lg text-on-surface font-mono truncate hover:bg-surface-container-high transition-colors">
                      {path}
                    </code>
                    <CopyButton text={path} />
                  </div>
                </div>
              )
            )
          }
        </div>
        <details class="mt-8 border-t border-outline-variant pt-6 group">
          <summary
            class="cursor-pointer text-xs font-mono uppercase tracking-widest text-on-surface-variant hover:text-on-background transition-colors list-none flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-sm group-open:rotate-90 transition-transform">chevron_right</span>
            Alternate OS Nodes
          </summary>
          <div
            class="mt-6 space-y-6 pl-4 border-l border-outline-variant"
          >
            <div>
              <h4 class="font-mono text-xs uppercase tracking-tighter text-surface-tint mb-4">Linux Environment</h4>
              <div class="space-y-3">
                {
                  Object.entries(troubleshootingConfig.paths.linux).map(
                    ([key, path]) => (
                      <div class="flex flex-col lg:flex-row lg:items-center gap-2">
                        <span class="font-mono text-[10px] uppercase text-on-surface-variant opacity-70 min-w-[80px]">
                          {key}:
                        </span>
                        <div class="flex-1 flex items-center gap-2">
                          <code class="flex-1 text-[10px] bg-surface-container px-2 py-1 rounded text-on-surface-variant font-mono truncate">
                            {path}
                          </code>
                          <CopyButton text={path} />
                        </div>
                      </div>
                    )
                  )
                }
              </div>
            </div>
          </div>
        </details>
      </div>

      <!-- Common Issues -->
      <div class="glass-card mb-8 p-8 rounded-2xl">
        <h2 class="text-xl font-bold mb-8 flex items-center gap-2 text-on-background font-mono uppercase tracking-widest">
          <span>🔧</span>
          Resolution Protocols
        </h2>

        <div class="space-y-8">
          <div class="group">
            <h3 class="font-bold text-on-background mb-3 flex items-center gap-2 group-hover:text-surface-tint transition-colors">
              <span class="w-1.5 h-1.5 bg-surface-tint rounded-full"></span>
              Mod not loading after subscription
            </h3>
            <ol
              class="list-decimal list-inside space-y-2 text-on-surface-variant text-sm pl-4"
            >
              <li>Fully close the game and Steam client</li>
              <li>Restart Steam to force Workshop sync verification</li>
              <li>Launch Upload Labs</li>
              <li>Verify presence of the modular settings interface</li>
            </ol>
          </div>

          <div class="group">
            <h3 class="font-bold text-on-background mb-3 flex items-center gap-2 group-hover:text-surface-tint transition-colors">
              <span class="w-1.5 h-1.5 bg-surface-tint rounded-full"></span>
              Runtime exception on startup
            </h3>
            <ol
              class="list-decimal list-inside space-y-2 text-on-surface-variant text-sm pl-4"
            >
              <li>Deactivate all third-party mods for isolation testing</li>
              <li>Check `Core` module status in the log files</li>
              <li>Verify game file integrity via Steam</li>
              <li>Report the exception with full log stack trace</li>
            </ol>
          </div>

          <div class="group">
            <h3 class="font-bold text-on-background mb-3 flex items-center gap-2 group-hover:text-surface-tint transition-colors">
              <span class="w-1.5 h-1.5 bg-surface-tint rounded-full"></span>
              Configuration persistence failure
            </h3>
            <ol
              class="list-decimal list-inside space-y-2 text-on-surface-variant text-sm pl-4"
            >
              <li>Check filesystem permissions for the AppData directory</li>
              <li>Verify the `tajs_mod_config.json` is not set to read-only</li>
              <li>Use the "Reset All Settings" directive in the Debug terminal</li>
            </ol>
          </div>
        </div>
      </div>

      <!-- What to Attach -->
      <div
        class="glass-card bg-surface-tint/5 border-surface-tint/20 p-8 rounded-2xl"
      >
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2 text-on-background font-mono uppercase tracking-widest">
          <span>📎</span>
          Incident Report Data
        </h2>
        <p class="text-on-surface-variant mb-6 text-sm">
          To expedite resolution, please include the following diagnostic data:
        </p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm mb-8">
          <li class="flex items-center gap-3 bg-surface-container p-3 rounded-lg border border-outline-variant">
            <span class="material-symbols-outlined text-surface-tint text-sm">check_circle</span>
            <span class="text-on-surface"><strong>Log files</strong> from the logs directory</span>
          </li>
          <li class="flex items-center gap-3 bg-surface-container p-3 rounded-lg border border-outline-variant">
            <span class="material-symbols-outlined text-surface-tint text-sm">check_circle</span>
            <span class="text-on-surface"><strong>config.json</strong> for state issues</span>
          </li>
          <li class="flex items-center gap-3 bg-surface-container p-3 rounded-lg border border-outline-variant">
            <span class="material-symbols-outlined text-surface-tint text-sm">check_circle</span>
            <span class="text-on-surface"><strong>Screenshots</strong> of the error state</span>
          </li>
          <li class="flex items-center gap-3 bg-surface-container p-3 rounded-lg border border-outline-variant">
            <span class="material-symbols-outlined text-surface-tint text-sm">check_circle</span>
            <span class="text-on-surface"><strong>Replication steps</strong> for the bug</span>
          </li>
        </ul>

        <div class="flex flex-wrap gap-4">
          <a
            href="https://github.com/TajsMods/Core/issues/new"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Open GitHub Issue
          </a>
          <a
            href="https://discord.gg/enigmadev"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Consult Discord
          </a>
        </div>
      </div>

      <!-- Page Actions -->
      <div class="mt-16 pt-8 border-t border-outline-variant">
        <PageActions editPath="/troubleshooting.astro" />
      </div>
    </div>
  </section>
</SiteLayout>
