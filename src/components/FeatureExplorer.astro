---
import FeatureCard from "./FeatureCard.astro";
import { features, categories } from "../data/features";
import { sitePath } from "../utils/urls";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const displayFeatures = compact ? features.slice(0, 6) : features;
---

<section class="section relative z-10" id="feature-explorer">
  <div class="container-wide">
    {
      !compact && (
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-on-surface font-mono uppercase tracking-widest">Protocol Explorer</h2>
          <p class="text-on-surface-variant max-w-2xl mx-auto text-lg italic">
            Search and filter through all system modules and features
          </p>
        </div>
      )
    }

    <!-- Search & Filters -->
    <div class="mb-12 space-y-8">
      <!-- Search -->
      <div class="relative max-w-2xl mx-auto group">
        <div class="absolute inset-0 bg-surface-tint/5 rounded-2xl blur-xl group-focus-within:bg-surface-tint/10 transition-colors"></div>
        <div class="relative">
          <input
            type="text"
            id="feature-search"
            placeholder="FILTER SYSTEM MODULES..."
            class="w-full px-6 py-4 pl-14 rounded-2xl border border-glass-border bg-glass-bg backdrop-blur-md text-on-surface font-mono text-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-surface-tint/50 focus:border-surface-tint/50 transition-all"
          />
          <svg
            class="absolute left-5 top-1/2 -translate-y-1/2 w-6 h-6 text-on-surface-variant group-focus-within:text-surface-tint transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>

      <!-- Category Filters -->
      <div class="flex flex-wrap justify-center gap-3" id="category-filters">
        <button class="chip chip-active font-mono text-xs" data-category="all"> [ ALL_MODULES ] </button>
        {
          Object.entries(categories).map(([key, cat]) => (
            <button class="chip font-mono text-xs" data-category={key}>
              <span class="mr-2 opacity-70">{cat.icon}</span>
              {cat.name.toUpperCase().replace(' ', '_')}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Features Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      id="features-grid"
    >
      {
        displayFeatures.map((feature) => (
          <div
            data-feature-id={feature.id}
            data-category={feature.category}
            data-tags={feature.tags.join(",")}
            class="h-full"
          >
            <FeatureCard feature={feature} />
          </div>
        ))
      }
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-24 glass-card rounded-2xl border border-glass-border">
      <div class="text-6xl mb-6 opacity-30">🔍</div>
      <p class="text-on-surface-variant text-lg mb-2">No matching modules found</p>
      <p class="text-on-surface-variant/70 text-sm font-mono uppercase">ERROR_CODE: NULL_RESULT</p>
    </div>

    {
      compact && (
        <div class="text-center mt-16">
          <a
            href={sitePath('/features/')}
            class="btn-secondary inline-flex items-center gap-3"
          >
            <span>Execute: All Features</span>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  function initFeatureExplorer() {
    const searchInput = document.getElementById(
      "feature-search"
    ) as HTMLInputElement;
    const categoryFilters = document.getElementById("category-filters");
    const grid = document.getElementById("features-grid");
    const noResults = document.getElementById("no-results");

    if (!searchInput || !categoryFilters || !grid) return;

    let activeCategory = "all";

    function filterFeatures() {
      const searchTerm = searchInput.value.toLowerCase();
      const items = grid!.querySelectorAll("[data-feature-id]");
      let visibleCount = 0;

      items.forEach((item) => {
        const el = item as HTMLElement;
        const category = el.dataset.category || "";
        const tags = el.dataset.tags || "";
        const text = el.textContent?.toLowerCase() || "";

        const matchesCategory =
          activeCategory === "all" || category === activeCategory;
        const matchesSearch =
          !searchTerm ||
          text.includes(searchTerm) ||
          tags.toLowerCase().includes(searchTerm);

        if (matchesCategory && matchesSearch) {
          el.style.display = "";
          visibleCount++;
        } else {
          el.style.display = "none";
        }
      });

      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
    }

    // Search input handler
    searchInput.addEventListener("input", filterFeatures);

    // Category filter handlers
    categoryFilters.querySelectorAll("button").forEach((btn) => {
      btn.addEventListener("click", () => {
        // Update active state
        categoryFilters.querySelectorAll("button").forEach((b) => {
          b.classList.remove("chip-active");
          b.classList.add("chip");
        });
        btn.classList.remove("chip");
        btn.classList.add("chip-active");

        activeCategory = btn.dataset.category || "all";
        filterFeatures();
      });
    });
  }

  document.addEventListener("astro:page-load", initFeatureExplorer);
  initFeatureExplorer();
</script>
