---
import { siteConfig } from "../config/site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="fixed top-0 w-full z-50 bg-background/90 backdrop-blur-md border-b border-glass-border">
  <div class="flex justify-between items-center px-8 h-16 w-full max-w-360 mx-auto">
    <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-2 text-2xl font-semibold tracking-tighter text-surface-tint font-headline hover:opacity-80 transition-opacity">
      <span class="text-accent-purple">♦</span>
      Taj's Mods
    </a>
    <nav class="hidden md:flex items-center gap-8 font-headline tracking-tight">
      <a class="text-on-surface-variant hover:text-surface-tint transition-colors" href={`${import.meta.env.BASE_URL}mods/`}>Mods</a>
      <a class="text-on-surface-variant hover:text-surface-tint transition-colors" href={`${import.meta.env.BASE_URL}docs/`}>Docs</a>
      <a class="text-on-surface-variant hover:text-surface-tint transition-colors" href={`${import.meta.env.BASE_URL}changelog/`}>Changelog</a>
    </nav>
    <div class="flex items-center gap-4 lg:gap-6 text-on-surface-variant font-headline text-sm tracking-wide">
      <ThemeToggle />
      <div class="h-6 w-px bg-glass-border hidden sm:block"></div>
      <a class="flex items-center gap-2 hover:text-surface-tint transition-colors" href={siteConfig.githubOrg} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-[20px]">code</span>
        <span class="hidden lg:inline">GitHub</span>
      </a>
      <a class="flex items-center gap-2 hover:text-surface-tint transition-colors" href={siteConfig.steamWorkshop} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-[20px]">sports_esports</span>
        <span class="hidden lg:inline">Steam Workshop</span>
      </a>
      <a class="flex items-center gap-2 hover:text-surface-tint transition-colors" href={siteConfig.discord} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-[20px]">forum</span>
        <span class="hidden lg:inline">Discord</span>
      </a>
    </div>
  </div>
</header>
