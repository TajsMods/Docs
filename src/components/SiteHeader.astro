---
import { siteConfig } from "../config/site";
---

<header class="fixed top-0 w-full z-50 bg-slate-950/90 backdrop-blur-md border-b border-white/10">
  <div class="flex justify-between items-center px-8 h-16 w-full max-w-[1440px] mx-auto">
    <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-2 text-2xl font-semibold tracking-tighter text-cyan-400 font-headline hover:opacity-80 transition-opacity">
      <span class="text-accent-purple">♦</span>
      Taj's Mods
    </a>
    <nav class="hidden md:flex items-center gap-8 font-headline tracking-tight">
      <a class="text-slate-400 hover:text-cyan-400 transition-colors" href={`${import.meta.env.BASE_URL}`}>Mods</a>
      <a class="text-slate-400 hover:text-cyan-200 transition-colors" href={`${import.meta.env.BASE_URL}docs`}>Docs</a>
      <a class="text-slate-400 hover:text-cyan-200 transition-colors" href={`${import.meta.env.BASE_URL}changelog`}>Changelog</a>
    </nav>
    <div class="flex items-center gap-6 text-on-surface-variant font-headline text-sm tracking-wide">
      <a class="flex items-center gap-2 hover:text-primary-fixed transition-colors" href={siteConfig.githubOrg} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-[20px]">code</span>
        <span class="hidden lg:inline">GitHub</span>
      </a>
      <a class="flex items-center gap-2 hover:text-primary-fixed transition-colors" href={siteConfig.steamWorkshop} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-[20px]">sports_esports</span>
        <span class="hidden lg:inline">Steam Workshop</span>
      </a>
      <a class="flex items-center gap-2 hover:text-primary-fixed transition-colors" href={siteConfig.discord} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-[20px]">forum</span>
        <span class="hidden lg:inline">Discord</span>
      </a>
    </div>
  </div>
</header>
