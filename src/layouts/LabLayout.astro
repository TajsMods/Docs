---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Taj's Mods</title>

    <!-- Google Fonts for the new design -->
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <style is:global>
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, h4, h5, h6, .font-display, .font-headline, .font-label { font-family: 'Space Grotesk', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .material-symbols-outlined.fill { font-variation-settings: 'FILL' 1; }
    </style>

    <ClientRouter />
  </head>
  <body class="bg-background text-on-background min-h-screen flex flex-col selection:bg-surface-tint selection:text-on-primary">
    <!-- TopAppBar -->
    <header class="fixed top-0 w-full z-50 bg-slate-950/90 backdrop-blur-md border-b border-white/10">
      <div class="flex justify-between items-center px-8 h-16 w-full max-w-[1440px] mx-auto">
        <div class="flex items-center gap-2 text-2xl font-semibold tracking-tighter text-cyan-400 font-headline">
          <span class="text-accent-purple">♦</span>
          Taj's Mods
        </div>
        <nav class="hidden md:flex items-center gap-8 font-headline tracking-tight">
          <a class="text-cyan-400 border-b-2 border-cyan-400 pb-1" href="/">Mods</a>
          <a class="text-slate-400 hover:text-cyan-200 transition-colors" href="/docs">Docs</a>
          <a class="text-slate-400 hover:text-cyan-200 transition-colors" href="/changelog">Changelog</a>
        </nav>
        <div class="flex items-center gap-6 text-on-surface-variant font-headline text-sm tracking-wide">
          <a class="flex items-center gap-2 hover:text-primary-fixed transition-colors" href={siteConfig.githubOrg}>
            <span class="material-symbols-outlined text-[20px]">code</span>
            <span class="hidden lg:inline">GitHub</span>
          </a>
          <a class="flex items-center gap-2 hover:text-primary-fixed transition-colors" href={siteConfig.steamWorkshop}>
            <span class="material-symbols-outlined text-[20px]">sports_esports</span>
            <span class="hidden lg:inline">Steam Workshop</span>
          </a>
          <a class="flex items-center gap-2 hover:text-primary-fixed transition-colors" href={siteConfig.discord}>
            <span class="material-symbols-outlined text-[20px]">forum</span>
            <span class="hidden lg:inline">Discord</span>
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow pt-24 pb-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full mt-auto bg-slate-950 border-t border-white/5">
      <div class="flex flex-col md:flex-row justify-between items-center py-12 px-8 max-w-[1440px] mx-auto">
        <div class="text-primary font-['Inter'] text-sm uppercase tracking-widest mb-6 md:mb-0">
          © 2024 Taj's Mods. Licensed under MIT.
        </div>
        <nav class="flex gap-8 font-['Inter'] text-sm uppercase tracking-widest">
          <a class="text-on-surface-variant hover:text-primary-fixed hover:underline decoration-surface-tint/50 transition-colors" href={siteConfig.githubReleases}>GitHub Releases</a>
          <a class="text-on-surface-variant hover:text-primary-fixed hover:underline decoration-surface-tint/50 transition-colors" href={siteConfig.steamWorkshop}>Steam Workshop</a>
          <a class="text-on-surface-variant hover:text-primary-fixed hover:underline decoration-surface-tint/50 transition-colors" href={siteConfig.discord}>Discord</a>
          <a class="text-on-surface-variant hover:text-primary-fixed hover:underline decoration-surface-tint/50 transition-colors" href={siteConfig.docs}>Documentation</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
